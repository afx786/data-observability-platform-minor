# ---------------------------------------------------------------------------
# Backend (FastAPI) - copy to backend/.env or export as environment variables
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_observability
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication - replace the secret before any deployment
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin (used by backend/jobs/create_admin.py)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP alerting
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Frontend (Vite) - copy to frontend/.env
# Leave empty to use the Vite dev proxy on /api
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
